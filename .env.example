# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Memories to Melody
USE_MOCK_PROVIDERS=true
VIDEO_FEATURE_ENABLED=false

# Supabase (optional — mock local store used when unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=melora-media

# Stripe (optional — mock checkout used when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email (optional — console transport used when unset)
RESEND_API_KEY=
EMAIL_FROM="Memories to Melody <hello@memoriestomelody.com>"

# AI providers
LYRICS_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
MUSIC_PROVIDER=mock
MUSIC_PROVIDER_URL=
MUSIC_PROVIDER_API_KEY=
VIDEO_PROVIDER=mock
VIDEO_PROVIDER_URL=
VIDEO_PROVIDER_API_KEY=
COVER_PROVIDER=music
COVER_PROVIDER_URL=
COVER_PROVIDER_API_KEY=

# Jobs & security
JOB_WORKER_SECRET=dev-worker-secret
CRON_SECRET=
LISTEN_TOKEN_SECRET=

# Rate limiting (local fallback in development; required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upload security (required and fail-closed in production)
MALWARE_SCAN_REQUIRED=false
MALWARE_SCANNER_URL=
MALWARE_SCANNER_API_KEY=

# SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
