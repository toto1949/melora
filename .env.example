# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Melora
USE_MOCK_PROVIDERS=true

# Supabase (optional — mock local store used when unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=melora-media

# Stripe (optional — mock checkout used when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email (optional — console transport used when unset)
RESEND_API_KEY=
EMAIL_FROM="Melora <hello@melora.app>"

# AI providers
LYRICS_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
MUSIC_PROVIDER=mock
VIDEO_PROVIDER=mock

# Jobs
JOB_WORKER_SECRET=dev-worker-secret
